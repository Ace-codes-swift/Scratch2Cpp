#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 n;
    vec4 rgb;
};

layout(std430, set = 0, binding = 0) readonly buffer TriBuf {
    Triangle tris[];
};

layout(std140, set = 1, binding = 0) uniform Params {
    vec4 camera;
    vec4 hvFov;
    vec4 light;
    ivec4 gridSampTri;
};

layout(std430, set = 0, binding = 1) buffer OutBuf {
    uint outRgba[];
};

vec3 camDir(float hDeg, float vDeg) {
    const float d = 3.14159265358979323846 / 180.0;
    float h = hDeg * d;
    float v = vDeg * d;
    vec3 dir = vec3(cos(v) * sin(h), sin(v), cos(v) * cos(h));
    float len = length(dir);
    return len > 1e-8 ? dir / len : dir;
}

bool hitTri(vec3 orig, vec3 dir, Triangle tri, out float tHit) {
    vec3 e1 = tri.v1.xyz - tri.v0.xyz;
    vec3 e2 = tri.v2.xyz - tri.v0.xyz;
    vec3 p = cross(dir, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-8) return false;
    float inv = 1.0 / det;
    vec3 s = orig - tri.v0.xyz;
    float u = dot(s, p) * inv;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(s, e1);
    float v = dot(dir, q) * inv;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, q) * inv;
    if (t <= 1e-4) return false;
    tHit = t;
    return true;
}

uint packRgba(vec3 c) {
    uvec3 u = uvec3(clamp(c, vec3(0.0), vec3(1.0)) * 255.0);
    return u.r | (u.g << 8) | (u.b << 16) | (255u << 24);
}

void main() {
    int grid = gridSampTri.x;
    int samp = max(gridSampTri.y, 1);
    int triCount = gridSampTri.z;
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= grid || gid.y >= grid) return;

    vec3 acc = vec3(0.0);
    for (int s = 0; s < samp; ++s) {
        float jitter = samp == 1 ? 0.0 : (float(s) / float(samp) - 0.5);
        float hOff = hvFov.z * 0.5 + (float(gid.x) + jitter) * (-hvFov.z / float(grid));
        float vOff = -hvFov.z * 0.5 + (float(gid.y) + jitter) * (hvFov.z / float(grid));
        vec3 dir = camDir(hvFov.x + hOff, hvFov.y + vOff);
        float best = 1e30;
        int hit = -1;
        vec3 hitP = vec3(0.0);
        vec3 orig = camera.xyz;
        for (int i = 0; i < triCount; ++i) {
            float t = 0.0;
            if (hitTri(orig, dir, tris[i], t) && t < best) {
                best = t;
                hit = i;
                hitP = orig + dir * t;
            }
        }
        if (hit >= 0) {
            Triangle tri = tris[hit];
            vec3 n = tri.n.xyz;
            vec3 toL = light.xyz - hitP;
            if (dot(n, toL) < 0.0) n = -n;
            float dist = max(0.15, length(toL));
            float ndotl = max(0.0, dot(normalize(n), normalize(toL)));
            float lambert = cos(ndotl * 3.14159265358979323846 / 180.0);
            vec3 c = tri.rgb.xyz * (lambert * (1.0 / (dist / 4.0)));
            c = pow(max(c, vec3(1e-6)), vec3(0.454545));
            acc += c;
        }
    }
    acc /= float(samp);
    outRgba[gid.y * grid + gid.x] = packRgba(acc);
}
